# El Bunker — environment variables
# Copy this file to .env (gitignored) and fill in values locally. Do NOT commit real secrets.

# ─── Google OAuth2 (REQUIRED) ────────────────────────────────
# Same OAuth client_id is used for production and development.
# Make sure the OAuth client at https://console.cloud.google.com/apis/credentials
# has BOTH origins as "Authorized JavaScript origins":
#   • https://el-bunker-beige.vercel.app     (production)
#   • http://localhost:5174                   (development, Vite default)
# If you see a 400 origin_mismatch error in dev console, add your local origin here.
# To use a separate dev client_id (safer), set:
#   VITE_GOOGLE_CLIENT_ID_DEV=xxx.apps.googleusercontent.com
# and the app will warn at boot if you're on localhost but the prod client_id is set.
VITE_GOOGLE_CLIENT_ID=your-oauth-client.apps.googleusercontent.com

# ─── Worker / API (REQUIRED for production) ──────────────────
# Cloudflare Worker URL serving the REST API (entries, tracks, tags, queues, sessions).
VITE_API_URL=https://el-bunker-api.thebunker-admin.workers.dev

# ─── Cloudflare R2 (server-side only) ────────────────────────
# Used by the Worker for file uploads. NOT exposed to frontend.
# Set these in wrangler.toml or via wrangler secret, NOT here.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=el-bunker-music
# R2_PUBLIC_BASE=https://music.elbunker.app

# ─── Dev mode helper ─────────────────────────────────────────
# Set to "1" to enable verbose auth logging in browser console.
# Useful when debugging local OAuth issues.
# VITE_AUTH_DEBUG=1
